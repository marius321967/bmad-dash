{
  "name": "bmad-dash",
  "displayName": "BMAD Dash",
  "description": "Dashboard for BMAD projects: epics, stories, artifacts, and recent activity at a glance.",
  "version": "0.0.2",
  "publisher": "whisker-studio",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/marius321967/bmad-dash"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "bmad",
    "dashboard",
    "sprint",
    "epics"
  ],
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#070C20",
    "theme": "dark"
  },
  "activationEvents": [
    "onCommand:bmad.showDash",
    "workspaceContains:**/_bmad/config.toml"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "bmad.showDash",
        "title": "BMAD: Show Dash"
      }
    ]
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.spec.json",
    "test": "jest --config jest.config.js",
    "test:smoke": "node build.mjs && node test/smoke/build-test.mjs && xvfb-run -a tsx test/smoke/orchestrate.ts",
    "visual": "tsx test/visual/server.ts",
    "lint": "eslint .",
    "package": "npm run build && cd dist && npx --no-install @vscode/vsce package --no-dependencies --baseImagesUrl https://raw.githubusercontent.com/marius321967/bmad-dash/main"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@iarna/toml": "^2.2.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.4",
    "globals": "^17.7.0",
    "jest": "^30.3.0",
    "ts-jest": "^29.4.11",
    "tslib": "^2.3.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.62.1",
    "yaml": "^2.9.0"
  }
}
